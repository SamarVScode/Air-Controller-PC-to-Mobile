<Window x:Class="InputTester.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Phone-as-Gamepad Raw Input Diagnostic &amp; Injection Tester"
        Height="650" Width="950"
        Background="#18181b" Foreground="#f4f4f5"
        FontFamily="Segoe UI, Consolas"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#27272a" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                    <TextBlock Text="Phase 0 Input Verification &amp; Raw Input Monitor" FontSize="18" FontWeight="SemiBold" Foreground="#38bdf8"/>
                    <TextBlock Text="Monitors WM_INPUT (Raw Keyboard MakeCodes + Raw Mouse relative deltas) globally via RIDEV_INPUTSINK" FontSize="12" Foreground="#a1a1aa"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnSelfTest" Content="Run SendInput Self-Test" Margin="6,0" Padding="12,6" Background="#0284c7" Foreground="White" FontWeight="Medium" Click="BtnSelfTest_Click"/>
                    <Button x:Name="BtnClear" Content="Clear Log" Margin="6,0" Padding="12,6" Background="#3f3f46" Foreground="White" Click="BtnClear_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Live Key & Mouse HUD Status -->
        <Border Grid.Row="1" Background="#27272a" CornerRadius="8" Padding="10" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Held Keys: " FontWeight="Bold" Foreground="#e4e4e7" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtHeldKeys" Text="None" Foreground="#4ade80" FontWeight="SemiBold" Margin="4,0,20,0" VerticalAlignment="Center"/>
                <TextBlock Text="Mouse Buttons: " FontWeight="Bold" Foreground="#e4e4e7" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtMouseButtons" Text="None" Foreground="#facc15" FontWeight="SemiBold" Margin="4,0,20,0" VerticalAlignment="Center"/>
                <TextBlock Text="Cumulative Mouse Deltas (X, Y): " FontWeight="Bold" Foreground="#e4e4e7" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtMouseTotals" Text="0, 0" Foreground="#38bdf8" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </WrapPanel>
        </Border>

        <!-- Log Output -->
        <Border Grid.Row="2" Background="#09090b" CornerRadius="8" BorderBrush="#27272a" BorderThickness="1" Padding="8">
            <ListBox x:Name="LstEvents" Background="Transparent" BorderThickness="0" Foreground="#22c55e"
                     FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Footer / Options -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <CheckBox x:Name="ChkAutoScroll" Content="Auto-scroll to latest" IsChecked="True" Foreground="#a1a1aa" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <CheckBox x:Name="ChkFilterMouseMove" Content="Log Mouse Moves (high volume)" IsChecked="False" Foreground="#a1a1aa" Margin="16,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <TextBlock x:Name="TxtStatus" Text="Raw Input active" Foreground="#a1a1aa" HorizontalAlignment="Right" DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</Window>
