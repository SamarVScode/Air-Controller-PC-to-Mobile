{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "None",
    "moduleResolution": "node",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "types": ["google-apps-script"],
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
